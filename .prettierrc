{
  "singleQuote": true,
  "trailingComma": "es5",
  "printWidth": 100,
  "tabWidth": 2,
  "semi": true,
  "bracketSpacing": true,
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": [
    "^@angular/(.*)$",
    "^@fundamental-ngx/(.*)$",
    "^@ngrx/(.*)$",
    "^@luigi-project/(.*)$",
    "^rxjs(.*)$",
    "^graphql(.*)$",
    "^models/(.*)$",
    "^services/(.*)$",
    "^state/(.*)$",
    "^components/(.*)$",
    "^utils/(.*)$",
    "^[./]"
  ],
  "importOrderSeparation": false,
  "importOrderSortSpecifiers": true
}
